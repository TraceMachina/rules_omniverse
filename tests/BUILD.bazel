load("//omniverse:defs.bzl", "omni_app_bundle", "omni_asset_bundle", "omni_extension", "omni_extension_test", "omni_kit_app", "omni_kit_toolchain", "omni_manifest_test", "omni_repo_publish_config")

package(default_visibility = ["//visibility:public"])

omni_asset_bundle(
    name = "assets",
    srcs = ["assets/scene.usda"],
    bundle_name = "nativelink_test_assets",
)

omni_extension(
    name = "extension",
    srcs = glob(["extension/**"]),
    extension_name = "com.nativelink.test.viewer",
    manifest = "extension/config/extension.toml",
)

omni_kit_app(
    name = "app",
    extensions = [":extension"],
    settings = """
app.window.title = "Nativelink Test Viewer"
""",
    title = "Nativelink Test Viewer",
    version = "0.1.0",
)

omni_kit_toolchain(
    name = "fake_kit_toolchain_impl",
    kit = ":fake_kit.sh",
)

toolchain(
    name = "fake_kit_toolchain",
    toolchain = ":fake_kit_toolchain_impl",
    toolchain_type = "//omniverse:toolchain_type",
)

omni_app_bundle(
    name = "bundle",
    app = ":app",
    assets = [":assets"],
    bundle_name = "nativelink_test_viewer",
    extensions = [":extension"],
)

omni_repo_publish_config(
    name = "publish_config",
    extensions = [":extension"],
)

omni_manifest_test(
    name = "extension_metadata_test",
    expected_name = "com.nativelink.test.viewer",
    kind = "extension",
    target = ":extension",
    version = "0.1.0",
)

omni_manifest_test(
    name = "asset_metadata_test",
    expected_name = "nativelink_test_assets",
    kind = "asset_bundle",
    target = ":assets",
)

omni_manifest_test(
    name = "app_metadata_test",
    expected_name = "app",
    kind = "kit_app",
    target = ":app",
    version = "0.1.0",
)

omni_extension_test(
    name = "extension_fake_kit_test",
    extension = ":extension",
    kit = ":fake_kit.sh",
)

exports_files(["fake_kit.sh"])
