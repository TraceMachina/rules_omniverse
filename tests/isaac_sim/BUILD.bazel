load("@isaac_sim_test_pip//:requirements.bzl", "requirement")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Tests of the container runner and the Isaac Sim launcher. Analysis and query
# tests of isaac_sim_action and isaac_sim_platform, including the rule side of
# the runner's output and input flags, live in ./rules so the tests here do not
# depend on the new macros.

# Runner tests. They share container_runner_lib.sh, which puts a fake docker
# on PATH.
[sh_test(
    name = "container_runner_%s_test" % name,
    srcs = ["container_runner_%s_test.sh" % name],
    args = ["$(rootpath //omniverse/private:container_gpu_runner.sh)"],
    data = [
        "container_runner_lib.sh",
        "//omniverse/private:container_gpu_runner.sh",
    ],
) for name in [
    "cache_mounts",  # worker cache mounts
    "malformed_mounts",  # a malformed cache mount entry fails
    "empty_lists",  # no --env or --forward-env, on bash 3.2
    "writable_output",  # output opened for the container user, ownership given back
    "nonempty_output",  # an empty output fails even when the container exits 0
    "input_mounts",  # targets of symlinked inputs are mounted
    "unresolvable_input",  # a symlinked input whose directory cannot be resolved fails
    "signal",  # SIGTERM or SIGINT kills the container, then hands the output back
    "created",  # cancellation removes a container created but not yet started
]]

py_library(
    name = "launcher_testing",
    testonly = True,
    srcs = ["launcher_testing.py"],
    imports = ["."],
)

# Every launcher test lists the launcher in data and names it in env.
_LAUNCHER = "//omniverse/private:isaac_sim_launcher.py"

_LAUNCHER_ENV = {"ISAAC_SIM_LAUNCHER": "$(rootpath %s)" % _LAUNCHER}

# Scene dependency check and exit codes, with OpenUSD's usd-core.
py_test(
    name = "isaac_sim_launcher_test",
    srcs = ["isaac_sim_launcher_test.py"],
    data = [_LAUNCHER] + glob(["scene/**"]),
    env = _LAUNCHER_ENV | {"ISAAC_SIM_TEST_SCENE": "$(rootpath scene/root.usda)"},
    deps = [
        ":launcher_testing",
        requirement("usd-core"),
    ],
)

# Finding pxr in the image's extension cache. No usd-core here: the only pxr
# is the stub in the fake image.
py_test(
    name = "isaac_sim_launcher_pxr_test",
    srcs = ["isaac_sim_launcher_pxr_test.py"],
    data = [_LAUNCHER],
    env = _LAUNCHER_ENV,
    deps = [":launcher_testing"],
)

# How the launcher runs the script and learns how it ended: exit status, the
# wrapper file, close() reports and the example wrapper. fake_isaacsim/ is a
# stub of Isaac Sim's isaacsim package whose SimulationApp (kit/fake_kit.py)
# ends its process like Kit. image/ lays the package out as in the image;
# package/ is a second layout, which the close() tests also run with.
py_test(
    name = "isaac_sim_launcher_script_test",
    srcs = ["isaac_sim_launcher_script_test.py"],
    data = [
        _LAUNCHER,
        "//examples/isaac_sim:run_scene_based_sdg.py",
    ] + glob(["fake_isaacsim/**/*.py"]),
    env = _LAUNCHER_ENV | {
        "EXAMPLE_WRAPPER": "$(rootpath //examples/isaac_sim:run_scene_based_sdg.py)",
        "FAKE_ISAACSIM": "$(rootpath fake_isaacsim/image/isaacsim/__init__.py)",
        "FAKE_ISAACSIM_PACKAGE": "$(rootpath fake_isaacsim/package/isaacsim/__init__.py)",
        "FAKE_KIT": "$(rootpath fake_isaacsim/kit/fake_kit.py)",
    },
    deps = [":launcher_testing"],
)

# tools/usd_deps.py, the USD dependency generator (docs/usd_deps.md). Each test
# runs the //tools:usd_deps binary and finds the tool through it.
_USD_DEPS = "//tools:usd_deps"

_USD_DEPS_ENV = {"USD_DEPS": "$(rootpath %s)" % _USD_DEPS}

# What it lists, where it writes and when it fails, with OpenUSD's usd-core.
# The launcher is left out of data so the tool's own runfiles must be enough.
py_test(
    name = "usd_deps_test",
    srcs = ["usd_deps_test.py"],
    data = [_USD_DEPS],
    env = _USD_DEPS_ENV,
    deps = [requirement("usd-core")],
)

# The tool and the launcher read the same stubbed USD answer the same way. No
# usd-core here: the only pxr is the stub, and the no-pxr test needs none at all.
py_test(
    name = "usd_deps_resolution_test",
    srcs = ["usd_deps_resolution_test.py"],
    data = [
        _LAUNCHER,
        _USD_DEPS,
    ],
    env = _LAUNCHER_ENV | _USD_DEPS_ENV,
    deps = [":launcher_testing"],
)

# A generated list, loaded by a real isaac_sim_action, passes the launcher's
# check with the stub Isaac Sim. usd_deps_scene/ holds the package.
py_test(
    name = "usd_deps_action_test",
    srcs = ["usd_deps_action_test.py"],
    data = [
        _LAUNCHER,
        _USD_DEPS,
        "//tests/isaac_sim/usd_deps_scene:generate_argv",
        "//tests/isaac_sim/usd_deps_scene:package_files",
        "//tests/isaac_sim/usd_deps_scene:stage.usda",
    ] + glob(["fake_isaacsim/**/*.py"]),
    env = _LAUNCHER_ENV | _USD_DEPS_ENV | {
        "FAKE_ISAACSIM": "$(rootpath fake_isaacsim/image/isaacsim/__init__.py)",
        "FAKE_KIT": "$(rootpath fake_isaacsim/kit/fake_kit.py)",
        "USD_DEPS_ACTION_ARGV": "$(rootpath //tests/isaac_sim/usd_deps_scene:generate_argv)",
        "USD_DEPS_SCENE": "$(rootpath //tests/isaac_sim/usd_deps_scene:stage.usda)",
    },
    deps = [
        ":launcher_testing",
        requirement("usd-core"),
    ],
)
