load("//omniverse:defs.bzl", "omni_app_bundle", "omni_asset_bundle", "omni_extension", "omni_kit_app", "omni_manifest_test", "omni_repo_publish_config")

package(default_visibility = ["//visibility:public"])

omni_asset_bundle(
    name = "nativelink_assets",
    srcs = glob(["data/**"]),
    bundle_name = "nativelink_assets",
)

omni_extension(
    name = "nativelink_build_viewer_ext",
    srcs = glob([
        "com/**",
        "config/**",
        "data/**",
    ]),
    extension_name = "com.nativelink.build.viewer",
    manifest = "config/extension.toml",
)

omni_kit_app(
    name = "nativelink_build_viewer",
    extensions = [":nativelink_build_viewer_ext"],
    settings = """
app.window.title = "Nativelink Build Viewer"
app.exts.folders."++" = ["${app}/../exts"]
""",
    title = "Nativelink Build Viewer",
    version = "0.1.0",
)

omni_app_bundle(
    name = "nativelink_bundle",
    app = ":nativelink_build_viewer",
    assets = [":nativelink_assets"],
    bundle_name = "nativelink_build_viewer",
    extensions = [":nativelink_build_viewer_ext"],
)

omni_repo_publish_config(
    name = "nativelink_publish",
    extensions = [":nativelink_build_viewer_ext"],
)

omni_manifest_test(
    name = "nativelink_extension_metadata_test",
    expected_name = "com.nativelink.build.viewer",
    kind = "extension",
    target = ":nativelink_build_viewer_ext",
    version = "0.1.0",
)
