// Single-host NativeLink CAS, scheduler, and H200 worker for an ephemeral
// evaluation machine. Set NL_NVME_ROOT to the 5 TB NVMe mount before launch.
{
  stores: [
    {
      name: "CAS_MAIN_STORE",
      filesystem: {
        content_path: "${NL_NVME_ROOT:-/mnt/nvme}/rules-omniverse/cas/content",
        temp_path: "${NL_NVME_ROOT:-/mnt/nvme}/rules-omniverse/cas/tmp",
        eviction_policy: {
          max_bytes: 2000000000000,
        },
      },
    },
    {
      name: "AC_MAIN_STORE",
      filesystem: {
        content_path: "${NL_NVME_ROOT:-/mnt/nvme}/rules-omniverse/ac/content",
        temp_path: "${NL_NVME_ROOT:-/mnt/nvme}/rules-omniverse/ac/tmp",
        eviction_policy: {
          max_bytes: 64000000000,
        },
      },
    },
    {
      name: "WORKER_FAST_SLOW_STORE",
      fast_slow: {
        fast: {
          filesystem: {
            content_path: "${NL_NVME_ROOT:-/mnt/nvme}/rules-omniverse/worker-cas/content",
            temp_path: "${NL_NVME_ROOT:-/mnt/nvme}/rules-omniverse/worker-cas/tmp",
            eviction_policy: {
              max_bytes: 512000000000,
            },
          },
        },
        slow: {
          ref_store: {
            name: "CAS_MAIN_STORE",
          },
        },
      },
    },
  ],
  schedulers: [
    {
      name: "MAIN_SCHEDULER",
      simple: {
        supported_platform_properties: {
          cpu_count: "minimum",
          gpu_count: "minimum",
          gpu_model: "exact",
          OSFamily: "priority",
          worker_runtime: "exact",
          "container-runtime": "exact",
          "container-image": "priority",
        },
      },
    },
  ],
  workers: [
    {
      local: {
        worker_api_endpoint: {
          uri: "grpc://127.0.0.1:50061",
        },
        // Keep long-action limits deployment-configurable instead of encoding
        // them in rules or individual targets.
        max_action_timeout_s: "${NL_MAX_ACTION_TIMEOUT:-2h}",
        max_upload_timeout_s: "${NL_MAX_UPLOAD_TIMEOUT:-30m}",
        cas_fast_slow_store: "WORKER_FAST_SLOW_STORE",
        upload_action_result: {
          ac_store: "AC_MAIN_STORE",
        },
        work_directory: "${NL_NVME_ROOT:-/mnt/nvme}/rules-omniverse/work",
        // Keep SDK locations deployment-specific. NativeLink copies PYTHONPATH
        // from its own environment into each action without putting a host path
        // in this public configuration.
        additional_environment: {
          NL_NVME_ROOT: "from_environment",
          PATH: "from_environment",
          PYTHONPATH: "from_environment",
          RULES_OMNIVERSE_USD_LD_LIBRARY_PATH: "from_environment",
          RULES_OMNIVERSE_USD_PYTHON: "from_environment",
          RULES_OMNIVERSE_USD_PYTHONPATH: "from_environment",
          RULES_OMNIVERSE_BAZEL_VERSION: "from_environment",
          RULES_OMNIVERSE_EXECUTION_BACKEND: "from_environment",
        },
        platform_properties: {
          cpu_count: {
            query_cmd: "nproc",
          },
          gpu_count: {
            values: ["1"],
          },
          gpu_model: {
            values: ["H200"],
          },
          OSFamily: {
            values: ["linux"],
          },
          worker_runtime: {
            values: ["ovphysx-0.4.13_ovrtx-0.3.0.312915_usd-optimize-1.0.4_openusd-25.11"],
          },
          "container-runtime": {
            values: ["docker"],
          },
          "container-image": {
            values: [""],
          },
        },
        use_namespaces: false,
        use_mount_namespace: false,
      },
    },
  ],
  servers: [
    {
      name: "client",
      listener: {
        http: {
          // Keep the plaintext REAPI listener private by default. Use a tunnel
          // or an authenticated TLS proxy for a Bazel client on another host.
          socket_address: "${NL_CLIENT_LISTEN_ADDR:-127.0.0.1:50051}",
        },
      },
      services: {
        cas: [{ cas_store: "CAS_MAIN_STORE" }],
        ac: [{ ac_store: "AC_MAIN_STORE" }],
        bytestream: [{ cas_store: "CAS_MAIN_STORE" }],
        execution: [{ cas_store: "CAS_MAIN_STORE", scheduler: "MAIN_SCHEDULER" }],
        capabilities: [{ remote_execution: { scheduler: "MAIN_SCHEDULER" } }],
        health: {},
      },
    },
    {
      name: "worker_api",
      listener: {
        http: {
          socket_address: "127.0.0.1:50061",
        },
      },
      services: {
        worker_api: {
          scheduler: "MAIN_SCHEDULER",
        },
        health: {},
      },
    },
  ],
  global: {
    max_open_files: 65536,
  },
}
